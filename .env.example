# Sonora — local/Vercel environment template

# MusicGPT (server only)
MUSICGPT_API_KEY=
MUSICGPT_BASE_URL=https://api.musicgpt.com/api/public
MUSICGPT_PLAN=
MUSICGPT_MOCK=0
MUSICGPT_LIVE_TEST=0

# Public application URLs
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres — Vercel Neon integration can inject DATABASE_URL
DATABASE_URL=
NEON_DATABASE_URL=

# Upstash Redis — Vercel Marketplace integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — Vercel Blob integration
BLOB_READ_WRITE_TOKEN=

# Authentication — wired in the auth integration pass
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Webhook verification
WEBHOOK_SECRET=
