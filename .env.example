# Sonora v1 — local + Vercel environment template
# Never commit real secrets. Configure these in Vercel Project Settings > Environment Variables.

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Auth.js v5 + Google OAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres
# Dedicated project: sonora-ai-music-studio
# Target database: sonora_v2
DATABASE_URL=
NEON_DATABASE_URL=

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# MusicGPT (server-only)
MUSICGPT_API_KEY=
MUSICGPT_BASE_URL=https://api.musicgpt.com/api/public
MUSICGPT_PLAN=
MUSICGPT_MOCK=0
MUSICGPT_LIVE_TEST=0

# Provider webhook verification
WEBHOOK_SECRET=
